# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # ใช้ฝั่งเบราว์เซอร์เพื่อรับสัญญาณ Realtime เท่านั้น (อ่านตารางไม่ได้)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # ห้ามใส่ NEXT_PUBLIC_ ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น

# สุ่มสตริงยาว ๆ:  openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# ── แจ้งเตือน Telegram (ไม่ใส่ก็ได้ แอปทำงานปกติ) ──
TELEGRAM_BOT_TOKEN=            # จาก @BotFather
TELEGRAM_BOT_USERNAME=         # ชื่อบอทไม่ต้องมี @ เช่น baan_rao_bot
TELEGRAM_WEBHOOK_SECRET=       # สตริงสุ่ม a-z A-Z 0-9 _ - (ใช้ยืนยันว่าคำขอมาจาก Telegram จริง)
APP_URL=https://your-app.vercel.app   # ใส่ลิงก์เปิดรายการในข้อความแจ้งเตือน (ไม่ใส่ก็ได้)

# ── กัน Supabase ฟรีถูกพักโปรเจกต์ (Vercel Cron เรียก /api/keepalive วันละครั้ง) ──
CRON_SECRET=                   # สตริงสุ่มยาว ๆ Vercel จะแนบให้เองตอนเรียก cron
